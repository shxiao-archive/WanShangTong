ENVIRONMENT=development
DATABASE_URL=sqlite:///./wanzhou.db
JWT_SECRET=replace-with-at-least-32-random-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-separate-at-least-32-character-random-key
CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS=
