ARG BASE_IMAGE=wst2-api
FROM ${BASE_IMAGE}

USER root
WORKDIR /workspace
ENV PYTHONPATH=/workspace
COPY requirements.txt requirements-dev.txt ./
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --timeout 300 --retries 10 -r requirements-dev.txt
COPY app ./app
COPY alembic.ini .
COPY alembic ./alembic
COPY tests ./tests
RUN chown -R app:app /workspace
USER app

CMD ["pytest", "-q", "tests"]
